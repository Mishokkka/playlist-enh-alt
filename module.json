{
    "title": "Playlist Enchantment",
    "description": "Playlist and hotbar controls for Foundry VTT v13. Local performance and compatibility patch with native synchronized fades, batched playback controls, and incremental UI updates.",
    "version": "1.3.10",
    "url": "https://github.com/Plushtoast/playlistenchantment",
    "languages": [
        {
            "lang": "de",
            "name": "Deutsch",
            "path": "lang/de.json"
        },
        {
            "lang": "en",
            "name": "English",
            "path": "lang/en.json"
        },
        {
            "lang": "pl",
            "name": "Polski",
            "path": "lang/pl.json"
        }
    ],
    "esmodules": [
        "bundle/modules/init.js"
    ],
    "styles": [
        "styles/css/playlist.css"
    ],
    "id": "playlistenchantment",
    "authors": [
        {
            "name": "Huepfklotz"
        }
    ],
    "persistentStorage": true,
    "compatibility": {
        "minimum": "13",
        "verified": "13.351",
        "maximum": "13"
    },
    "flags": {
        "hotReload": {
            "extensions": [
                "css",
                "html",
                "hbs",
                "json"
            ],
            "paths": [
                "templates",
                "styles/css",
                "lang"
            ]
        }
    }
}
